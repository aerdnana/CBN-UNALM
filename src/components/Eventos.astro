---
const { items } = Astro.props;
---
<section id="eventos" class="wrap section">
  <div class="head"><span class="kicker">Agenda</span><h2 class="h2">Eventos</h2></div>
  <div class="list">
    {items.map((e, i) => (
      <details open={i === 0}>
        <summary><span class="when">{e.fechaTexto}</span><span class="t"><b>{e.titulo}</b><small>{e.lugar}</small></span><i></i></summary>
        <div class="more">{e.imagen && <img src={e.imagen} alt={e.titulo} loading="lazy" />}<p>{e.descripcion}</p></div>
      </details>
    ))}
  </div>
</section>
<style>
.head{display:flex;flex-direction:column;gap:14px;margin-bottom:40px}.list{border-top:1.5px solid var(--ink)}
details{border-bottom:1px solid rgba(19,38,26,.18)}
summary{list-style:none;cursor:pointer;padding:26px 4px;display:grid;grid-template-columns:minmax(110px,160px) minmax(0,1fr) auto;gap:24px;align-items:center}summary::-webkit-details-marker{display:none}summary:hover{background:var(--bg2)}
.when{font:500 13px var(--mono);color:var(--green)}.t{display:flex;flex-direction:column;gap:4px}.t b{font:700 clamp(20px,2.4vw,30px)/1.1 var(--display)}.t small{font-size:14px;color:var(--muted)}
summary i{width:40px;height:40px;border-radius:50%;border:1.5px solid var(--ink);display:grid;place-items:center;font-style:normal;font-weight:700;font-size:18px}
summary i::before{content:'+'}details[open] summary i::before{content:'–'}
.more{padding:0 4px 28px calc(min(160px,25%) + 28px);display:flex;flex-direction:column;gap:14px;max-width:820px}.more p{margin:0;font-size:16px;line-height:1.6;color:var(--muted)}.more img{border-radius:16px;max-width:320px}
@media (max-width:640px){summary{grid-template-columns:1fr auto}.when{grid-column:1/-1}.more{padding-left:4px}}
</style>
