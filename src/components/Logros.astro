---
const { items, cifras = [] } = Astro.props;
---
<section id="logros" class="wrap section">
  <div class="head"><span class="kicker">Trayectoria</span><h2 class="h2">Logros y reconocimientos</h2></div>
  {cifras.length > 0 && <div class="cifras">{cifras.map(c => <div><b>{c.numero}</b><span>{c.texto}</span></div>)}</div>}
  <div class="list">
    {items.map(l => (
      <article>
        <span class="cat">{l.categoria}{l.anio ? ` · ${l.anio}` : ''}</span>
        <div class="t"><b>{l.titulo}</b>{l.evento && <small>{l.evento}</small>}{l.descripcion && <p>{l.descripcion}</p>}</div>
      </article>
    ))}
  </div>
</section>
<style>
.head{display:flex;flex-direction:column;gap:14px;margin-bottom:40px}
.cifras{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,200px),1fr));gap:1px;background:rgba(19,38,26,.15);border:1px solid rgba(19,38,26,.15);border-radius:22px;overflow:hidden;margin-bottom:40px}
.cifras>div{background:var(--bg);padding:26px;display:flex;flex-direction:column;gap:6px}
.cifras b{font:800 clamp(40px,5vw,64px)/1 var(--display);letter-spacing:-.03em;color:var(--green)}.cifras span{font-size:14px;color:var(--muted)}
.list{border-top:1.5px solid var(--ink)}
article{display:grid;grid-template-columns:minmax(110px,160px) minmax(0,1fr);gap:24px;padding:24px 4px;border-bottom:1px solid rgba(19,38,26,.18)}
.cat{font:500 13px var(--mono);color:var(--green)}
.t{display:flex;flex-direction:column;gap:6px;max-width:820px}.t b{font:700 clamp(18px,2vw,26px)/1.15 var(--display)}
.t small{font-size:14px;color:var(--muted)}.t p{margin:0;font-size:15px;line-height:1.55;color:var(--muted)}
@media (max-width:640px){article{grid-template-columns:1fr;gap:8px}}
</style>
