---
const { items } = Astro.props;
---
<section id="areas" class="wrap areas">
  <div class="head"><span class="kicker">Áreas</span><h2 class="h2">Nuestras áreas</h2></div>
  <div class="grid">{items.map(a => <div class="a">{a.foto ? <img src={a.foto} alt={a.nombre} loading="lazy" /> : <div class="ph pic">foto del área</div>}<b>{a.nombre}</b><span>{a.descripcion}</span></div>)}</div>
</section>
<style>
.areas{padding-block:24px 96px}@media (max-width:640px){.areas{padding-block:8px 56px}}
.head{display:flex;flex-direction:column;gap:14px;margin-bottom:36px}
.grid{display:flex;flex-wrap:wrap;justify-content:center;gap:28px 18px}.a{flex:0 1 210px;min-width:140px}
.a{display:flex;flex-direction:column;gap:6px;text-align:center}.a img,.pic{aspect-ratio:1;border-radius:50%;width:100%;object-fit:cover;margin-bottom:8px}
.a b{font:700 18px var(--display)}.a span{font-size:14px;color:var(--muted)}
</style>
